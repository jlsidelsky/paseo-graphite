{
  "manifest_version": 3,
  "name": "Paseo for Graphite",
  "version": "0.1.0",
  "description": "Chat with the Paseo sessions behind a Graphite PR.",
  "key": "",
  "permissions": [
    "sidePanel",
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://graphite.com/*",
    "https://*.graphite.com/*",
    "https://graphite.dev/*",
    "https://*.graphite.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Paseo sessions for this PR",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://graphite.com/*",
        "https://*.graphite.com/*",
        "https://graphite.dev/*",
        "https://*.graphite.dev/*"
      ],
      "js": [
        "content.js",
        "review.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/32.png"
      ],
      "matches": [
        "https://graphite.com/*",
        "https://*.graphite.com/*",
        "https://graphite.dev/*",
        "https://*.graphite.dev/*"
      ]
    }
  ]
}
